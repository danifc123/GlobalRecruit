# Copie para .env e preencha. NUNCA commitar o .env real.

# postgresql+asyncpg://user:password@host:port/dbname
# porta 5434 porque o docker-compose local mapeia assim (5432 pode já estar
# ocupada por um Postgres nativo do SO) — ajuste se seu setup for diferente
DATABASE_URL=postgresql+asyncpg://globalrecruit:globalrecruit@127.0.0.1:5434/globalrecruit

# gerar com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-valor-por-um-segredo-forte-gerado-aleatoriamente

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# origem exata do front em produção/dev — nunca usar "*"
CORS_ORIGINS=http://localhost:4200

ENVIRONMENT=development

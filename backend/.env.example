# Copie para .env e preencha. NUNCA commitar o .env real.

# postgresql+asyncpg://user:password@host:port/dbname
# (também aceita a string crua do Neon/Render: postgresql://...?sslmode=require
# — o backend converte sozinho para o formato do asyncpg)
# porta 5434 porque o docker-compose local mapeia assim (5432 pode já estar
# ocupada por um Postgres nativo do SO) — ajuste se seu setup for diferente
DATABASE_URL=postgresql+asyncpg://globalrecruit:globalrecruit@127.0.0.1:5434/globalrecruit

# gerar com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-valor-por-um-segredo-forte-gerado-aleatoriamente

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# origem exata do front em produção/dev — nunca usar "*"
CORS_ORIGINS=http://localhost:4200

ENVIRONMENT=development

# Tradução automática (DeepL) dos textos das vagas para português do Brasil.
# Opcional: vazio = tradução desativada (o sistema funciona normalmente, só
# mostra os textos no original). Chave gratuita em https://www.deepl.com/pro-api
# — NUNCA commitar a chave real.
DEEPL_API_KEY=
# plano Free usa api-free.deepl.com; plano Pro usa https://api.deepl.com
DEEPL_API_URL=https://api-free.deepl.com

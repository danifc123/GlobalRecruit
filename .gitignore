# Segurança básica — nunca versionar segredos/variáveis de ambiente reais,
# mesmo que criados fora de backend/ ou globalRecruit/ por engano.
*.env
!.env.example

# Arquivos de sistema operacional e editores
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.idea/

# Claude Code — worktrees e config local de cada máquina não são versionados
.claude/worktrees/
.claude/settings.local.json

# guia de deploy pessoal (variaveis, contas) -- fica so local
docs/DEPLOY_PRODUCAO.md
